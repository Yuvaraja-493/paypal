# ==========================================
# PayPilot AI - Environment Configuration
# ==========================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# PayPal Developer Sandbox Credentials
# Get your Sandbox API keys at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI Provider API Keys (Optional - built-in autonomous heuristic engine acts as fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# AG Grid License Key (Optional - runs community edition with rich features out of the box)
AG_GRID_LICENSE_KEY=
